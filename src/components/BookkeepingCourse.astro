---
import type { CollectionEntry } from 'astro:content';
import type { Qualification } from '../data/qualifications';
import { bokiCourse, bokiCourses, bokiAssessments, bokiFieldNames } from '../data/bookkeeping';
import { beginnerReviewed, beginnerWorkload } from '../data/boki-beginner';
import { costReviewed, costWorkload } from '../data/cost-beginner';
import { boki3Reviewed, boki3Workload } from '../data/boki3';
import { href } from '../lib/site';
import Share from './Share.astro';
import Icon from './Icon.astro';
interface Props {
  q: Qualification;
  lessons: CollectionEntry<'lessons'>[];
}
const { q, lessons } = Astro.props;
const course = bokiCourse(q.id)!;
const tests = bokiAssessments(lessons).filter((a) => a.kind !== 'lesson');
const beginner = q.id === 'boki-beginner';
const cost = q.id === 'cost-beginner';
const third = q.id === 'boki-3';
const workload = beginner
  ? beginnerWorkload(lessons)
  : cost
    ? costWorkload(lessons)
    : third
      ? boki3Workload(lessons)
      : undefined;
---

<div class="container page-section">
  <nav class="grade-selector" aria-label="日商簿記の級を選ぶ">
    <a href={href('qualifications/boki/')}>級の違い・選び方</a>
    {bokiCourses.map((c) => (
      <a href={href(`qualifications/${c.id}/`)} aria-current={c.id === q.id ? 'page' : undefined}>
        {c.name.replace('日商', '')}
      </a>
    ))}
  </nav>
  <div class="course-grid">
    <div>
      <section class="course-section">
        <h2>例題から、処理の理由まで学ぶ</h2>
        <p>{q.scope}</p>
        <p>{course.prerequisite}</p>
        {cost ? (
          <p>
            対象は原価計算初級の現行範囲です。公開されている2027年度の案内でも、原価計算初級の範囲に変更はありません。
          </p>
        ) : third ? (
          <div>
            <p>対象は2027年3月31日までの3級商業簿記です。取引ごとの仕訳から帳簿の照合、決算書の作成へ進みます。</p>
            <p>
              本試験で資料を読み取る練習には、<a href={href('qualifications/boki-3/b3x-asset-register-reconciliation/')}>固定資産台帳の空欄を埋める</a>、
              <a href={href('qualifications/boki-3/b3x-inventory-period-reconciliation/')}>期末棚卸と未記帳取引を照合する</a>、
              <a href={href('qualifications/boki-3/b3x-loan-year-boundary/')}>決算をまたぐ利息を分ける</a>の3レッスンが役立ちます。
            </p>
          </div>
        ) : (
          <div class="notice compact">
            <strong>2026年度の範囲を参照する独自教材</strong>
            <p>
              公式問題の転載や公認教材ではありません。用語の説明・例題・練習で扱う範囲を対応表に示します。模試の配点と採点は当サイト独自です。
            </p>
            <p>
              2027年4月からの出題区分表は確定済みです。本コースの適用年度と混同せず、受験する年度の公式資料をご確認ください。
            </p>
          </div>
        )}
        <div class="assessment-links">
          <a href={href(`qualifications/${q.id}/coverage/`)}>対応表・公式資料・教材の制約</a>
          <a href={href(`downloads/${q.id}-curriculum.txt`)} download>
            学習ツリーとスケジュールをTXTで保存
          </a>
          <a href={href(`qualifications/${q.id}/tests/`)}>用語・総復習・模試を選ぶ</a>
        </div>
      </section>
      {q.id === 'boki-1' && (
        <section class="course-section" id="free-mock">
          <h2>日商簿記1級の無料基礎模試</h2>
          <p>前半・後半ともに90分です。基本論点を確認しながら、本試験に向けた時間配分を練習できます。設問の数、資料量、配点は当サイト独自の設定です。</p>
          <ul>
            <li><a href={href('qualifications/boki-1/tests/boki-1-mock-front/')}>前半の模試を始める（商業簿記・会計学）</a></li>
            <li><a href={href('qualifications/boki-1/tests/boki-1-mock-back/')}>後半の模試を始める（工業簿記・原価計算）</a></li>
          </ul>
        </section>
      )}
      <section class="course-section">
        <h2>無理なく進める学習案</h2>
        <p>{course.plan}</p>
        {cost && (
          <nav class="prose" aria-labelledby="cost-practice-order">
            <h3 id="cost-practice-order">総復習と模試へ進む順番</h3>
            <p>
              例題をひととおり解いたら、<a href={href('qualifications/cost-beginner/cb2-department-cost-route/')}>部門から製品への配賦</a>、
              <a href={href('qualifications/cost-beginner/cb2-inventory-cutoff/')}>月をまたぐ在庫原価</a>、
              <a href={href('qualifications/cost-beginner/cb2-mix-planning/')}>複数商品の損益分岐点</a>、
              <a href={href('qualifications/cost-beginner/cb2-sales-ledger-reconciliation/')}>販売明細と売上高差異</a>で資料を読む順番を練習できます。
            </p>
            <ol>
              <li><a href="#steps">各ユニットの例題・用語・総合確認</a>で計算の根拠を確かめる。</li>
              <li><a href={href('qualifications/cost-beginner/tests/cost-beginner-review-all/')}>全範囲の総復習</a>で、当月の実績と翌月の計画から必要な資料を選ぶ。</li>
              <li><a href="#cost-mock-practice">40分の模擬試験</a>で資料を読む順番と時間の使い方を確かめる。</li>
            </ol>
          </nav>
        )}
        {beginner && (
          <p>
            <a href={href('study-guides/boki-beginner-exam-dates/')}>試験日と会場を探す方法</a>では、随時試験と統一試験日、申込先の違いを確認できます。
          </p>
          <p>受験日が決まったら、<a href={href('study-guides/boki-beginner-exam-day/')}>当日の持ち物と電卓の条件</a>も確認しておきましょう。</p>
        )}
        {workload && (
          <div class="prose">
            <p>
              本文・例題・理解度チェックの目安は{workload.lessonMinutes}
              分、復習・用語・総合確認・模試と解き直しを含む全体は約{Math.ceil(workload.total / 60)}
              時間です。反復量により延びることがあります。
            </p>
            <ul>
              {[30, 60, 90].map((minutes) => (
                <li>
                  1日{minutes}分・週5日なら、約{Math.ceil(workload.total / (minutes * 5))}
                  週間。覚え直しが必要な日は次のレッスンを急がず復習に充てます。
                </li>
              ))}
            </ul>
          </div>
        )}
        <p>
          学習期間は公式の必要時間ではありません。理解と解き直しに応じて調整します。各レッスンの翌日と1週間後に、解説を見ずに例題を解き直してください。
        </p>
      </section>
      <section class="course-section" id="steps">
        <div class="section-heading">
          <h2>学習ステップ</h2>
          <span class="tag" data-course-progress={q.id}>
            未学習
          </span>
        </div>
        <p>学習済みの印とテストの得点は別に保存します。前の内容が曖昧なら、リンクから戻って復習できます。</p>
        {course.groups.map((group, i) => (
          <details class="curriculum-unit" open>
            <summary>
              ユニット{i + 1}　{group}
            </summary>
            <ol class="lesson-list">
              {lessons
                .filter((l) => l.data.unit === i + 1)
                .map((l) => (
                  <li class="lesson-row" data-lesson-row={l.data.stableId}>
                    <span class="lesson-number">{String(l.data.order).padStart(2, '0')}</span>
                    <div class="lesson-row-body">
                      <h3>
                        <a href={href(`qualifications/${q.id}/${l.data.stableId}/`)}>{l.data.title}</a>
                      </h3>
                      <div class="lesson-meta">
                        <span>{l.data.minutes}分の目安</span>
                        <span>{bokiFieldNames[l.data.subject ?? 'basics']}</span>
                        <span data-status-label={l.data.stableId}>未学習</span>
                      </div>
                    </div>
                    <button
                      disabled
                      aria-busy="true"
                      class="star-button"
                      data-bookmark={l.data.stableId}
                      aria-pressed="false"
                      aria-label={`${l.data.title}をブックマーク`}
                      type="button"
                    >
                      <Icon name="star" size={21} />
                    </button>
                  </li>
                ))}
            </ol>
            <div class="unit-assessments">
              <a href={href(`qualifications/${q.id}/tests/${q.id}-unit-${i + 1}-glossary/`)}>用語確認</a>
              <a href={href(`qualifications/${q.id}/tests/${q.id}-unit-${i + 1}-review/`)}>
                ユニット総合確認
              </a>
            </div>
          </details>
        ))}
      </section>
      <section class="course-section" id={cost ? 'cost-mock-practice' : undefined}>
        <h2>総復習と模擬試験</h2>
        {beginner && (
          <p>
            <a href={href('study-guides/boki-beginner-past-questions/')}>公式サンプル問題の使い方と、過去問に頼らない復習法</a>
            では、最初に解くときのメモの取り方と、模試へ進むまでの練習手順を紹介します。
          </p>
        )}
        {beginner && (
          <p><a href={href('qualifications/boki-beginner/bb2-integration/#closing-lab-title')}>一か月の仕訳と残高を一つずつ追う</a>。仕訳の借方・貸方を予想し、現金と利益の変化を確かめます。
            続いて<a href={href('qualifications/boki-beginner/bb2-opening-balances/')}>二か月の試算表を照合する</a>練習で、繰越額と当月の取引を分けてから総復習へ進みます。</p>
        )}
        <p>
          {beginner
            ? 'ユニット総合確認はレッスン末尾とは別の独自問題です。総復習24問は新しい複合問題12問とユニット確認の再利用12問。用語は本文の定義から出題し、用語総復習では同じ問題を再利用します。40分模試2回には別の独自問題と月次の共通資料を使います。'
            : cost
              ? 'ユニットの総合確認と全範囲の総復習には独自の問題を使います。総復習の共通資料では、当月の原価・在庫・利益を集計し、翌月のCVPと当月の売上高差異を計算します。用語総復習では各ユニットの用語問題を再利用します。40分模試2回は、異なる問題と資料で練習できます。'
              : third
                ? 'ユニット確認と総復習は、レッスン末とは異なる条件の独立問題です。用語総復習は各ユニットの用語問題を再利用します。60分模試2回は、科目と金額を入力する仕訳、帳簿、決算資料を使う別々の独自問題です。'
                : 'ユニット総合確認と総復習はレッスンの問題を再利用します。用語確認は各レッスンの定義から出題します。模試は別の独自問題です。'}
        </p>
        <div class="assessment-links">
          {tests
            .filter((a) => a.id.includes('-all') || a.kind === 'mock')
            .map((a) => (
              <a class="assessment-link" href={href(`qualifications/${q.id}/tests/${a.id}/`)}>
                <strong>{a.title}</strong>
                <span>
                  {a.questions.length}小問{a.minutes ? `・${a.minutes}分` : ''}
                </span>
              </a>
            ))}
        </div>
      </section>
      <section class="course-section">
        <h2>次の学習へ</h2>
        {beginner && (
          <p>合格後の応募書類に迷ったら、<a href={href('study-guides/boki-beginner-resume/')}>履歴書の資格欄の書き方と記入例</a>をご覧ください。</p>
        )}
        <p>
          {q.id === 'boki-1'
            ? '例題を解けた論点も、公式の出題区分表や会計基準の条件を確認し、組合せ問題・長い資料問題で復習しましょう。'
            : '例題を解説なしで説明できるようになったら、総復習で苦手な項目を確かめ、次の級の学習へ進みましょう。'}
        </p>
        {q.id !== course.next && <a href={href(`qualifications/${course.next}/`)}>次のコースを見る</a>}
      </section>
      <Share title={q.name} url={new URL(href(`qualifications/${q.id}/`), Astro.site).href} />
    </div>
    <aside class="course-sidebar">
      <div class="sidebar-box">
        <h2>試験と学習の区別</h2>
        <p>
          {q.id === 'boki-1'
            ? '公式は前半90分・後半90分（休憩あり）。合計70%以上、各科目40%以上が合格基準です。'
            : `公式の試験時間は${course.minutes}分です。合格基準は100点満点で70点以上（70%以上）です。`}
        </p>
        <p>
          当サイトの学習時間と練習得点は独自の目安です。受験申込・試験の実施は主催者の公式案内をご利用ください。
        </p>
        <a href={q.official}>日本商工会議所の案内</a>
        <p>
          公式資料の確認：
          {beginner ? beginnerReviewed : cost ? costReviewed : third ? boki3Reviewed : '2026-10-25'}
        </p>
      </div>
      <div class="sidebar-box">
        <h2>この端末に保存</h2>
        <p>
          学習記録はブラウザ内に保存します。端末間で自動同期はしません。定期的にバックアップを書き出してください。
        </p>
        <a href={href('progress/#backup')}>記録のバックアップ</a>
      </div>
    </aside>
  </div>
</div>
