---
import type { CollectionEntry } from 'astro:content';
import type { Qualification } from '../data/qualifications';
import { bokiCourse, bokiCourses, bokiAssessments, bokiFieldNames } from '../data/bookkeeping';
import { beginnerReviewed, beginnerWorkload } from '../data/boki-beginner';
import { costReviewed, costWorkload } from '../data/cost-beginner';
import { href } from '../lib/site';
import Share from './Share.astro';
import Icon from './Icon.astro';
interface Props {
  q: Qualification;
  lessons: CollectionEntry<'lessons'>[];
}
const { q, lessons } = Astro.props;
const course = bokiCourse(q.id)!;
const tests = bokiAssessments(lessons).filter((a) => a.kind !== 'lesson');
const beginner = q.id === 'boki-beginner';
const cost = q.id === 'cost-beginner';
const workload = beginner ? beginnerWorkload(lessons) : cost ? costWorkload(lessons) : undefined;
---

<div class="container page-section">
  <nav class="grade-selector" aria-label="日商簿記の級を選ぶ">
    <a href={href('qualifications/boki/')}>級の違い・選び方</a>
    {bokiCourses.map((c) => (
      <a href={href(`qualifications/${c.id}/`)} aria-current={c.id === q.id ? 'page' : undefined}>
        {c.name.replace('日商', '')}
      </a>
    ))}
  </nav>
  <div class="course-grid">
    <div>
      <section class="course-section">
        <h2>例題から、処理の理由まで学ぶ</h2>
        <p>{q.scope}</p>
        <p>{course.prerequisite}</p>
        {cost ? <p>対象は原価計算初級の現行範囲です。公開されている2027年度の案内でも、原価計算初級の範囲に変更はありません。</p> : <div class="notice compact">
          <strong>2026年度の範囲を参照する独自教材</strong>
          <p>
            公式問題の転載や公認教材ではありません。用語の説明・例題・練習で扱う範囲を対応表に示します。模試の配点と採点は当サイト独自です。
          </p>
          <p>
            2027年4月からの出題区分表は確定済みです。本コースの適用年度と混同せず、受験する年度の公式資料をご確認ください。
          </p>
        </div>}
        <div class="assessment-links">
          <a href={href(`qualifications/${q.id}/coverage/`)}>対応表・公式資料・教材の制約</a>
          <a href={href(`downloads/${q.id}-curriculum.txt`)} download>
            学習ツリーとスケジュールをTXTで保存
          </a>
          <a href={href(`qualifications/${q.id}/tests/`)}>用語・総復習・模試を選ぶ</a>
        </div>
      </section>
      <section class="course-section">
        <h2>無理なく進める学習案</h2>
        <p>{course.plan}</p>
        {workload && <div class="prose">
          <p>本文・例題・理解度チェックの目安は{workload.lessonMinutes}分、復習・用語・総合確認・模試と解き直しを含む全体は約{Math.ceil(workload.total/60)}時間です。反復量により延びることがあります。</p>
          <ul>{[30,60,90].map(minutes=><li>1日{minutes}分・週5日なら、約{Math.ceil(workload.total/(minutes*5))}週間。覚え直しが必要な日は次のレッスンを急がず復習に充てます。</li>)}</ul>
        </div>}
        <p>
          学習期間は公式の必要時間ではありません。理解と解き直しに応じて調整します。各レッスンの翌日と1週間後に、解説を見ずに例題を解き直してください。
        </p>
      </section>
      <section class="course-section" id="steps">
        <div class="section-heading">
          <h2>学習ステップ</h2>
          <span class="tag" data-course-progress={q.id}>
            未学習
          </span>
        </div>
        <p>学習済みの印とテストの得点は別に保存します。前の内容が曖昧なら、リンクから戻って復習できます。</p>
        {course.groups.map((group, i) => (
          <details class="curriculum-unit" open>
            <summary>
              ユニット{i + 1}　{group}
            </summary>
            <ol class="lesson-list">
              {lessons
                .filter((l) => l.data.unit === i + 1)
                .map((l) => (
                  <li class="lesson-row" data-lesson-row={l.data.stableId}>
                    <span class="lesson-number">{String(l.data.order).padStart(2, '0')}</span>
                    <div class="lesson-row-body">
                      <h3>
                        <a href={href(`qualifications/${q.id}/${l.data.stableId}/`)}>{l.data.title}</a>
                      </h3>
                      <div class="lesson-meta">
                        <span>{l.data.minutes}分の目安</span>
                        <span>{bokiFieldNames[l.data.subject ?? 'basics']}</span>
                        <span data-status-label={l.data.stableId}>未学習</span>
                      </div>
                    </div>
                    <button disabled aria-busy="true"
                      class="star-button"
                      data-bookmark={l.data.stableId}
                      aria-pressed="false"
                      aria-label={`${l.data.title}をブックマーク`}
                      type="button"
                    >
                      <Icon name="star" size={21} />
                    </button>
                  </li>
                ))}
            </ol>
            <div class="unit-assessments">
              <a href={href(`qualifications/${q.id}/tests/${q.id}-unit-${i + 1}-glossary/`)}>用語確認</a>
              <a href={href(`qualifications/${q.id}/tests/${q.id}-unit-${i + 1}-review/`)}>
                ユニット総合確認
              </a>
            </div>
          </details>
        ))}
      </section>
      <section class="course-section">
        <h2>総復習と模擬試験</h2>
        <p>
          {beginner ? 'ユニット総合確認はレッスン末尾とは別の独自問題です。総復習24問は新しい複合問題12問とユニット確認の再利用12問。用語は本文の定義から出題し、用語総復習では同じ問題を再利用します。40分模試2回には別の独自問題と月次の共通資料を使います。' : cost ? 'ユニットの総合確認と全体の復習は、レッスン末の問題とは別の条件で解きます。用語総復習は各ユニットの用語問題を再利用します。模試は2回とも異なる独自問題で、資料の読み取りから製品・サービス別の利益まで確かめます。' : 'ユニット総合確認と総復習はレッスンの問題を再利用します。用語確認は各レッスンの定義から出題します。模試は別の独自問題です。'}
        </p>
        <div class="assessment-links">
          {tests
            .filter((a) => a.id.includes('-all') || a.kind === 'mock')
            .map((a) => (
              <a class="assessment-link" href={href(`qualifications/${q.id}/tests/${a.id}/`)}>
                <strong>{a.title}</strong>
                <span>
                  {a.questions.length}小問{a.minutes ? `・${a.minutes}分` : ''}
                </span>
              </a>
            ))}
        </div>
      </section>
      <section class="course-section">
        <h2>次の学習へ</h2>
        <p>
          {q.id === 'boki-1'
            ? '例題を解けた論点も、公式の出題区分表や会計基準の条件を確認し、組合せ問題・長い資料問題で復習しましょう。'
            : '例題を解説なしで説明できるようになったら、総復習で苦手な項目を確かめ、次の級の学習へ進みましょう。'}
        </p>
        {q.id !== course.next && <a href={href(`qualifications/${course.next}/`)}>次のコースを見る</a>}
      </section>
      <Share title={q.name} url={new URL(href(`qualifications/${q.id}/`), Astro.site).href} />
    </div>
    <aside class="course-sidebar">
      <div class="sidebar-box">
        <h2>試験と学習の区別</h2>
        <p>
          {q.id === 'boki-1'
            ? '公式は前半90分・後半90分（休憩あり）。合計70%以上、各科目40%以上が合格基準です。'
            : `公式の試験時間は${course.minutes}分です。合格基準は100点満点で70点以上（70%以上）です。`}
        </p>
        <p>
          当サイトの学習時間と練習得点は独自の目安です。受験申込・試験の実施は主催者の公式案内をご利用ください。
        </p>
        <a href={q.official}>日本商工会議所の案内</a>
        <p>公式資料の確認：{beginner ? beginnerReviewed : cost ? costReviewed : '2026-10-25'}</p>
      </div>
      <div class="sidebar-box">
        <h2>この端末に保存</h2>
        <p>
          学習記録はブラウザ内に保存します。端末間で自動同期はしません。定期的にバックアップを書き出してください。
        </p>
        <a href={href('progress/#backup')}>記録のバックアップ</a>
      </div>
    </aside>
  </div>
</div>
