---
import { zeirishiDeepLessons, zeirishiDeepUnits } from '../data/zeirishi-expanded';
import { href } from '../lib/site';
const { subject } = Astro.props;
const units = zeirishiDeepUnits.filter((unit) => unit.subject === subject);
---

{units.length > 0 && (
  <section class="course-section" aria-labelledby="deep-learning-units">
    <h2 id="deep-learning-units">詳しく学ぶ：解説・計算・記述の学習ユニット</h2>
    <p>
      以前の入門教材とは別の学習課程です。入門ページの学習済み記録は保管され、新しいレッスンや演習を自動で完了にすることはありません。単元ごとに説明、例題、独立した練習問題へ進みます。
    </p>
    {units.map((unit) => {
      const members = unit.lessonIds.map((id) => zeirishiDeepLessons.find((lesson) => lesson.id === id)!);
      return (
        <article class="curriculum-unit">
          <h3><a href={href(`qualifications/zeirishi/units/${unit.id}/`)}>{unit.title}</a></h3>
          <p>{unit.description}</p>
          <p>{members.length}レッスン・学習目安{members.reduce((sum, lesson) => sum + lesson.minutes, 0)}分（復習テストは別）</p>
          <p data-course-progress="zeirishi" data-course-subject={subject} data-course-unit={unit.number}>このブラウザの記録を読み込んでいます</p>
          <progress data-course-bar="zeirishi" data-course-subject={subject} data-course-unit={unit.number} max={members.length} value="0" aria-label={`${unit.title}の学習済みレッスン数`}>0 / {members.length}</progress>
          <a class="button secondary" data-course-start="zeirishi" data-course-subject={subject} data-course-unit={unit.number} href={href(`qualifications/zeirishi/${members[0]!.id}/`)}>この単元の続きから学ぶ</a>
        </article>
      );
    })}
  </section>
)}
