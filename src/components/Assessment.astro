---
import { assessmentMaterialIssues, type Assessment } from '../lib/assessment';
import { href } from '../lib/site';
interface Props {
  assessment: Assessment;
}
const { assessment: a } = Astro.props;
const materialIssues = assessmentMaterialIssues(a);
if (materialIssues.length) throw new Error(`${a.id}: ${materialIssues.join('; ')}`);
---

<section class="assessment" data-assessment aria-labelledby="assessment-heading">
  <h2 id="assessment-heading">{a.title}</h2>
  <p>{a.questions.length}問・何度でも解き直せます。レッスンの学習済み状態とは別に記録します。</p>
  {a.instructions && (
    <div class="notice compact">
      <p style="white-space:pre-line">{a.instructions}</p>
    </div>
  )}
  {a.kind === 'mock' && a.qualification === 'it-passport' && (
    <div class="notice compact">
      <strong>本試験の評価点とは異なります</strong>
      <p>
        本試験は100問・120分・四肢択一です。出題分野の目安に合わせ、ストラテジ35問、マネジメント20問、テクノロジ45問を出題します。本試験は100問中92問を評価対象としIRTで評価点を算出します。この模試は全100問を各1点で採点する独自の練習です。600点・分野別300点の公式基準へ換算したり、合否を判定したりしません。難易度や非採点問題も再現していません。
      </p>
    </div>
  )}
  <div class="assessment-start" data-assessment-start>
    <fieldset>
      <legend>取り組み方</legend>
      {a.minutes ? (
        <>
          <label class="quiz-option">
            <input type="radio" name="assessment-mode" value="timed" checked />
            時間を計って挑戦（{a.minutes}分・開始後は一時停止なし）
          </label>
          <label class="quiz-option">
            <input type="radio" name="assessment-mode" value="practice" />
            時間制限なしで練習
          </label>
        </>
      ) : (
        <p>時間制限なし。途中の解答もこのブラウザに保存します。</p>
      )}
    </fieldset>
    {a.minutes && (
      <p>
        制限時間はページを閉じている間も進みます。再訪時に期限を過ぎていれば、その時点までに保存された解答で終了します。
      </p>
    )}
    <p data-assessment-restore role="status"></p>
    <button type="button" class="button primary" data-assessment-begin disabled>
      準備中…
    </button>
    <p class="muted">問題の版：{a.version}。各テストの記録は直近100回まで保持します。</p>
  </div>
  <div data-assessment-active hidden>
    <div class="exam-toolbar">
      <strong data-question-position></strong>
      <span data-exam-timer role="timer" aria-live="off"></span>
      <span data-exam-save role="status">
        この端末に保存
      </span>
    </div>
    <p data-exam-announcement role="status" class="sr-only"></p>
    <p data-exam-count></p>
    <details class="question-map">
      <summary>問題一覧・未解答・見直し</summary>
      <p>✓ 解答済み・★ 見直し。印のない問題は未解答です。</p>
      <nav aria-label="問題を選ぶ" data-question-map></nav>
    </details>
  </div>
  {a.materials?.length && (
    <section class="assessment-materials" data-assessment-materials hidden aria-labelledby="material-heading">
      <h3 id="material-heading">問題の共通資料</h3>
      <p>設問で指定された資料を開いて確認できます。解答中も参照できます。</p>
      {a.materials.map((material) => (
        <details class="assessment-material" id={`material-${material.id}`}>
          <summary>{material.title}</summary>
          {material.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {material.tables?.map((table) => (
            <>
              <p class="material-table-hint muted">
                表が画面に収まらない場合は、横にスクロールして全ての列を確認できます。
              </p>
              <div class="table-scroll" role="region" tabindex="0" aria-label={table.caption}>
                <table>
                  <caption>{table.caption}</caption>
                  <thead>
                    <tr>
                      {table.headers.map((header) => (
                        <th scope="col">{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map((row) => (
                      <tr>
                        {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          ))}
        </details>
      ))}
    </section>
  )}
  <div class="assessment-questions" data-assessment-questions hidden>
    {a.questions.map((q, i) => (
      <fieldset class="assessment-question" data-question={q.id} data-question-index={i}>
        <legend tabindex="-1">
          問{i + 1}　{q.group && <span>{q.group}： </span>}
          {q.prompt}
        </legend>
        {q.materialIds?.length && (
          <p class="question-material-links">
            参照資料：
            {q.materialIds.map((id) => (
              <a href={`#material-${id}`} data-open-material={id}>
                {a.materials!.find((material) => material.id === id)!.title}
              </a>
            ))}
          </p>
        )}
        {q.input === 'journal' ? (
          <div class="journal-answer" data-journal-answer>
            <p class="journal-hint" id={`${q.id}-journal-hint`}>
              借方・貸方それぞれ必要な行だけ入力してください。各4行まで使えます。金額は円単位で、全角数字・カンマにも対応しています。科目と金額がそろっていない行や貸借が一致しない解答も途中記録として保存します。
            </p>
            <div class="journal-sides">
              {(['debits', 'credits'] as const).map((side) => (
                <fieldset
                  class="journal-side"
                  data-journal-side={side}
                  aria-describedby={`${q.id}-journal-hint`}
                >
                  <legend>{side === 'debits' ? '借方' : '貸方'}</legend>
                  {[0, 1, 2, 3].map((row) => (
                    <div class="journal-row" data-journal-row={row}>
                      <label>
                        {row + 1}行目の勘定科目
                        <select
                          name={`${q.id}-${side}-${row}-account`}
                          data-journal-account
                          autocomplete="off"
                          disabled
                        >
                          <option value="">選択してください</option>
                          {q.journal!.accounts.map((account) => (
                            <option value={account}>{account}</option>
                          ))}
                        </select>
                      </label>
                      <label>
                        {row + 1}行目の金額（円）
                        <input
                          type="text"
                          name={`${q.id}-${side}-${row}-amount`}
                          data-journal-amount
                          inputmode="decimal"
                          maxlength="80"
                          autocomplete="off"
                          spellcheck="false"
                          disabled
                        />
                      </label>
                    </div>
                  ))}
                </fieldset>
              ))}
            </div>
          </div>
        ) : q.input === 'essay' ? (
          <label class="written-answer">
            記述解答（4,000字まで・提出後に解答例と照合）
            <textarea
              name={q.id}
              data-written-answer
              rows="8"
              maxlength="4000"
              autocomplete="off"
              disabled
            ></textarea>
            <small>文章を自動判定しません。提出後に独自の確認基準を読み、自己確認点を記録できます。</small>
          </label>
        ) : q.input ? (
          <label class="written-answer">
            解答（{q.input === 'number' ? '金額・数値' : '勘定科目・用語'}）
            <input
              type="text"
              name={q.id}
              data-written-answer
              inputmode={q.input === 'number' && !q.signed ? 'decimal' : 'text'}
              maxlength="80"
              autocomplete="off"
              disabled
            />
            <small>
              数値は半角・全角とカンマに対応。問題文の単位で入力してください。負の数には「-」を使います。
            </small>
          </label>
        ) : (
          q.options.map((o, j) => (
            <label class="quiz-option">
              <input type="radio" name={q.id} value={j} disabled />
              <span>{o}</span>
            </label>
          ))
        )}
      </fieldset>
    ))}
  </div>
  <div data-assessment-controls hidden>
    <div class="exam-actions">
      <label class="flag-control">
        <input type="checkbox" data-review-flag />
        あとで見直す
      </label>
      <button class="button secondary" type="button" data-answer-clear>
        この問の解答を消す
      </button>
    </div>
    <div class="exam-actions">
      <button class="button secondary" type="button" data-question-prev>
        前の問題
      </button>
      <button class="button primary" type="button" data-question-next>
        次の問題
      </button>
      <button class="button secondary" type="button" data-assessment-submit>
        解答を提出する
      </button>
    </div>
  </div>
  <div class="assessment-results" data-assessment-results hidden tabindex="-1"></div>
  <section class="assessment-history">
    <h3>このテストの記録</h3>
    <div data-current-assessment-history>
      <p>まだ記録はありません。</p>
    </div>
  </section>
  <p class="saved-note muted">
    解答はこの端末のブラウザだけに保存します。<a href={href('progress/#backup')}>バックアップと復元</a>
    。レッスンを読んだだけではテストの得点は付きません。
  </p>
  <noscript>
    <style is:inline>
      .assessment-questions[hidden] {
        display: block !important;
      }
      .assessment-materials[hidden] {
        display: block !important;
      }
    </style>
    <p>本文と問題は読めます。解答・採点・記録にはJavaScriptが必要です。</p>
  </noscript>
  <dialog data-assessment-dialog aria-labelledby="assessment-confirm-title">
    <form method="dialog">
      <h3 id="assessment-confirm-title">解答を提出しますか？</h3>
      <p data-assessment-confirm-text></p>
      <div class="button-row">
        <button class="button secondary" value="cancel" autofocus>
          続けて解く
        </button>
        <button class="button primary" value="submit">
          提出して終了
        </button>
      </div>
    </form>
  </dialog>
  <script
    type="application/json"
    data-assessment-json
    set:html={JSON.stringify(a).replace(/</g, '\\u003c')}
  />
</section>
<style>
  .journal-hint {
    font-size: 0.9rem;
  }
  .journal-sides {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .journal-side {
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid var(--line);
  }
  .journal-side legend {
    padding-inline: 0.3rem;
    font-weight: 700;
  }
  .journal-row {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.75rem;
  }
  .journal-row + .journal-row {
    border-top: 1px solid var(--line);
  }
  .journal-row label {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    font-size: 0.9rem;
  }
  .journal-row input,
  .journal-row select {
    min-width: 0;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background-color: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  .journal-row input {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 40rem) {
    .journal-sides {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .assessment-materials {
    margin-block: 1.5rem;
  }
  .assessment-material {
    border: 1px solid var(--line);
    padding: 1rem;
    margin-block: 0.75rem;
    scroll-margin-top: 6rem;
  }
  .assessment-material summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .assessment-material p,
  .assessment-question legend {
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .question-material-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .question-material-links a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .assessment-material table {
    width: 100%;
    border-collapse: collapse;
    min-width: 28rem;
  }
  .material-table-hint {
    font-size: 0.85rem;
  }
  .assessment-material caption {
    text-align: left;
    font-weight: 700;
    margin-block: 1rem 0.5rem;
  }
  .assessment-material th,
  .assessment-material td {
    text-align: left;
    padding: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
</style>
