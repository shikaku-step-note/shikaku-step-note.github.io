---
import { journalAnswerText, type Assessment, type Question } from '../lib/assessment';

interface Props {
  title: string;
  questions: Question[];
  materials?: Assessment['materials'];
}
const { title, questions, materials } = Astro.props;
const materialById = new Map(materials?.map((material) => [material.id, material.title]));
const optionNumber = (index: number) => `${index + 1}．`;
function solution(question: Question) {
  if (question.journal) return journalAnswerText(JSON.stringify(question.journal));
  if (question.input === 'essay') return question.modelAnswer;
  if (question.input) return question.accepted?.[0];
  return `${optionNumber(question.answer)}${question.options[question.answer]}`;
}
---

<section
  class:list={[
    'lesson-print-only',
    'lesson-print-practice',
    { 'lesson-print-worksheet': questions.length > 1 },
  ]}
  aria-labelledby="print-practice-heading"
>
  <h2 id="print-practice-heading">{title}</h2>
  <p>解答・解説は、この問題のあとにまとめています。</p>
  {materials?.map((material) => (
    <section>
      <h3>{material.title}</h3>
      {material.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      {material.tables?.map((table) => (
        <table>
          <caption>{table.caption}</caption>
          <thead>
            <tr>
              {table.headers.map((header) => (
                <th scope="col">{header}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map((row) => (
              <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
            ))}
          </tbody>
        </table>
      ))}
    </section>
  ))}
  {questions.map((question, i) => (
    <div class="lesson-print-question">
      <h3>
        問{i + 1}
        {question.group && `　${question.group}`}
      </h3>
      <p>{question.prompt}</p>
      {!!question.materialIds?.length && (
        <p>参照資料：{question.materialIds.map((id) => materialById.get(id)).join('、')}</p>
      )}
      {question.journal ? (
        <table class="lesson-print-journal">
          <thead>
            <tr>
              <th scope="col">借方科目</th>
              <th scope="col">金額（円）</th>
              <th scope="col">貸方科目</th>
              <th scope="col">金額（円）</th>
            </tr>
          </thead>
          <tbody>
            {Array.from(
              { length: Math.max(2, question.journal.debits.length, question.journal.credits.length) },
              () => (
                <tr>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
              ),
            )}
          </tbody>
        </table>
      ) : question.input ? (
        <p class:list={['lesson-print-writing', { 'lesson-print-essay': question.input === 'essay' }]}>
          解答欄
        </p>
      ) : (
        <ol>
          {question.options.map((option) => (
            <li>{option}</li>
          ))}
        </ol>
      )}
    </div>
  ))}
  <section class="lesson-print-solutions" aria-labelledby="print-solutions-heading">
    <h2 id="print-solutions-heading">解答・解説</h2>
    {questions.map((question, i) => (
      <div class="lesson-print-question">
        <h3>
          問{i + 1}　{question.input ? '解答例' : '正解'}
        </h3>
        <p>
          <strong>{solution(question)}</strong>
        </p>
        <p>{question.explanation}</p>
        {question.rubric?.length && (
          <ul>
            {question.rubric.map((item) => (
              <li>
                {item.criterion}（{item.points}点）
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </section>
</section>
