---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { qualifications } from '../data/qualifications';
import { href } from '../lib/site';
import { getCollection } from 'astro:content';
import { zeirishiSubjects, zeirishiLearningOutline } from '../data/zeirishi';
import { zeirishiDeepUnits } from '../data/zeirishi-expanded';
import { STORAGE_LIMITS } from '../lib/storage';
const lessons = await getCollection('lessons', (l) => !l.data.archived);
---

<Layout
  title="マイ学習・ブックマーク"
  description="この端末に保存した学習の進み具合やブックマークを確認し、続きから学べます。記録のバックアップや復元もこちらから。"
  noindex
  breadcrumbs={[{ name: 'マイ学習', path: 'progress/' }]}
>
  <section class="container page-section" data-dashboard>
    <div class="page-heading">
      <p class="eyebrow">小さな一歩を、見えるかたちに</p>
      <h1>マイ学習</h1>
      <p>あなたのペースで、続きから。</p>
    </div>
    <div class="storage-banner">
      <Icon name="shield" size={22} />
      <div>
        <strong data-storage-label>この端末に保存</strong>
        <p data-storage-message>
          記録はこのブラウザに保存されます。端末間の自動同期はありません。定期的にバックアップを書き出しましょう。
        </p>
      </div>
    </div>
    <div class="progress-summary">
      <div>
        <strong data-total-completed>0</strong>
        <span>学習済みレッスン</span>
      </div>
      <div>
        <strong data-total-started>0</strong>
        <span>学習中のレッスン</span>
      </div>
      <div>
        <strong data-total-bookmarks>0</strong>
        <span>ブックマーク</span>
      </div>
    </div>
    <section class="resume-strip" data-home-resume hidden>
      <div>
        <h2>前回の続きから</h2>
        <p data-resume-title></p>
      </div>
      <a class="button primary" data-resume-link href={href('qualifications/')}>
        学習を再開 <Icon name="arrow" size={18} />
      </a>
    </section>
    <div class="dashboard-grid">
      <section>
        <h2>資格ごとの進み具合</h2>
        <div class="course-progress-list">
          {qualifications.map((q) => (
            <article class="progress-course">
              <div class="section-heading">
                <h3>
                  <a href={href(`qualifications/${q.id}/`)}>{q.name}</a>
                </h3>
                <span data-course-progress={q.id}>
                  0 / {lessons.filter((l) => l.data.qualification === q.id).length} レッスン
                </span>
              </div>
              <progress
                data-course-bar={q.id}
                max={lessons.filter((l) => l.data.qualification === q.id).length}
                value="0"
                aria-label={`${q.name}の学習済みレッスン数`}
              >
                0 / {lessons.filter((l) => l.data.qualification === q.id).length}
              </progress>
              <p class="muted">
                {q.status === 'course' ? '公開中の基礎コース' : '入門サンプル'}
                の完了数です。試験範囲の習得率や合格可能性ではありません。
              </p>
            </article>
          ))}
        </div>
        <details class="curriculum-unit">
          <summary>税理士の科目別の進み具合</summary>
          <p>全11科目を学ぶ必要はありません。受験する科目を選び、各科目の記録を確認してください。</p>
          {zeirishiSubjects.map((s) => (
            <section class="progress-course">
              <h3>
                <a href={href(`qualifications/zeirishi/subjects/${s.id}/`)}>{s.name}</a>
              </h3>
              <p data-course-progress="zeirishi" data-course-subject={s.id}>
                記録を読み込んでいます
              </p>
              <progress
                data-course-bar="zeirishi"
                data-course-subject={s.id}
                value="0"
                max={zeirishiLearningOutline.filter((r) => r.subject === s.id).length}
                aria-label={`${s.name}の学習済みレッスン数`}
              >
                0
              </progress>
              <a
                data-course-start="zeirishi"
                data-course-subject={s.id}
                href={href(`qualifications/zeirishi/${zeirishiLearningOutline.find((r) => r.subject === s.id)!.id}/`)}
              >
                この科目を学ぶ・復習する
              </a>
              {zeirishiDeepUnits.filter((unit) => unit.subject === s.id).map((unit) => (
                <p>
                  <a href={href(`qualifications/zeirishi/units/${unit.id}/`)}>{unit.title}</a>：
                  <span data-course-progress="zeirishi" data-course-subject={s.id} data-course-unit={unit.number}>記録を読み込んでいます</span>
                </p>
              ))}
            </section>
          ))}
        </details>
      </section>
      <section>
        <h2>星をつけたレッスン</h2>
        <div data-bookmark-list>
          <div class="empty-state">
            <Icon name="star" size={30} />
            <h3>復習したいところを、ここに。</h3>
            <p>レッスンの星ボタンを押すと、あとからすぐに読み返せます。</p>
            <a href={href('qualifications/')}>学びたい資格を選ぶ</a>
          </div>
        </div>
      </section>
    </div>
    <section class="history-section">
      <h2>理解度チェック・用語・復習・模試の記録</h2>
      <div data-assessment-history>
        <p class="muted">テストの結果を読み込んでいます…</p>
      </div>
    </section>
    <section class="history-section">
      <h2>学習の記録</h2>
      <div data-history-list>
        <p class="muted">学習を始めると、レッスンの状態と最新の練習結果がここに表示されます。</p>
      </div>
    </section>
    <section class="backup-section" id="backup">
      <div>
        <p class="eyebrow">大切な記録を手元に</p>
        <h2>バックアップと復元</h2>
        <p>
          ブラウザのデータを削除すると、記録が消える場合があります。バックアップファイルを書き出すと、同じサイトを開いた別の端末でも読み込めます。
        </p>
      </div>
      <div class="backup-actions">
        <button class="button primary" id="export-progress" type="button">
          <Icon name="download" size={18} />
          バックアップを書き出す
        </button>
        <label class="file-label" for="import-file">
          バックアップファイルを選ぶ（JSON・最大{STORAGE_LIMITS.backupBytes / 1024 / 1024}MB）
        </label>
        <input type="file" id="import-file" accept=".json,application/json" />
        <p id="import-info" role="status"></p>
        <fieldset class="import-mode">
          <legend>読み込み方法</legend>
          <label>
            <input type="radio" name="import-mode" value="merge" checked />
            今の記録と統合する
          </label>
          <label>
            <input type="radio" name="import-mode" value="replace" />
            今の記録を置き換える
          </label>
        </fieldset>
        <p class="muted">
          統合ではレッスンとテストの各回ごとに更新日時が新しい記録を優先します。バックアップには途中の解答・期限・得点も含まれます。各テストは直近100回まで保持します。
        </p>
        <button class="button secondary" id="import-progress" type="button" disabled>
          選んだ記録を読み込む
        </button>
      </div>
    </section>
    <section class="reset-section">
      <div>
        <h2>この端末の記録をリセット</h2>
        <p>学習状態・星・練習結果がすべて消えます。先にバックアップを書き出してください。</p>
      </div>
      <button class="button danger" id="reset-progress" type="button">
        記録をリセット
      </button>
    </section>
    <noscript>
      <p>学習記録を表示するにはJavaScriptを有効にしてください。教材の本文はJavaScriptなしでも読めます。</p>
    </noscript>
  </section>
  <dialog id="confirm-dialog" aria-labelledby="confirm-title">
    <form method="dialog">
      <h2 id="confirm-title">記録を変更しますか？</h2>
      <p id="confirm-description"></p>
      <div class="button-row">
        <button class="button secondary" value="cancel" autofocus>
          キャンセル
        </button>
        <button class="button danger" value="confirm">
          変更する
        </button>
      </div>
    </form>
  </dialog>
</Layout>
