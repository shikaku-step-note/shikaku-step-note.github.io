---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import QualificationCard from '../components/QualificationCard.astro';
import { qualifications, availabilityText } from '../data/qualifications';
import { href } from '../lib/site';
---

<Layout
  title="資格ステップノート"
  description="資格の学びを、ひとつずつ。ITパスポート、日商簿記の各級、FP3級の入門を無料で学べる資格学習サイト。登録不要で、学習の進み具合をこの端末に保存できます。"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="small-rule"></span>学びたい気持ちに、次の一歩を。
        </p>
        <h1>
          無料で学べる
          <br />
          資格学習サイト<span class="period">。</span>
        </h1>
        <p class="hero-description">
          むずかしそうな資格も、小さなステップから。
          <br class="desktop-break" />
          「わかる」をひとつずつ、自分のペースで重ねよう。
        </p>
        <div class="button-row">
          <a class="button primary" href="#qualifications">
            学びたい資格を選ぶ <Icon name="arrow" size={19} />
          </a>
          <a class="text-link" href={href('guide/')}>
            はじめての方へ
          </a>
        </div>
        <div class="hero-benefits">
          <span>
            <Icon name="check" size={17} />
            すべて無料
          </span>
          <span>
            <Icon name="check" size={17} />
            登録不要
          </span>
          <span>
            <Icon name="check" size={17} />
            自分のペースで
          </span>
        </div>
      </div>
      <div class="pathway-visual" aria-label="読む、ためす、振り返るの順で学ぶ学習ステップ">
        <div class="visual-heading">
          <span>一歩ずつ、身につく。</span>
          <Icon name="leaf" size={25} />
        </div>
        <div class="pathway-line"></div>
        <div class="path-step step-one">
          <span class="step-number">1</span>
          <div>
            <small>まずはここから</small>
            <strong>知る・読む</strong>
            <p>身近な例で、基本をつかむ</p>
          </div>
          <Icon name="book" size={27} />
        </div>
        <div class="path-step step-two">
          <span class="step-number">2</span>
          <div>
            <small>理解をたしかめる</small>
            <strong>問題を解く</strong>
            <p>短い練習で、学びを自分のものに</p>
          </div>
          <Icon name="check" size={27} />
        </div>
        <div class="path-step step-three">
          <span class="step-number">3</span>
          <div>
            <small>次の一歩につながる</small>
            <strong>振り返る・続ける</strong>
            <p>学習記録を見て、続きから再開</p>
          </div>
          <Icon name="chart" size={27} />
        </div>
        <div class="visual-note">
          <span class="note-dot"></span>今日のひとつが、明日の自信に。
        </div>
      </div>
    </div>
  </section>
  <div class="container">
    <section class="resume-strip" data-home-resume hidden aria-label="学習を再開">
      <div>
        <span class="tag">おかえりなさい</span>
        <h2>前回の続きから、始めよう。</h2>
        <p data-resume-title></p>
      </div>
      <a class="button primary" data-resume-link href={href('progress/')}>
        学習を再開 <Icon name="arrow" size={18} />
      </a>
    </section>
  </div>
  <section class="section container" id="qualifications">
    <div class="section-heading">
      <div>
        <p class="eyebrow">興味があることから、始めよう</p>
        <h2>学びたい資格を選ぶ</h2>
      </div>
      <a class="text-link" href={href('qualifications/')}>
        すべての資格を見る <Icon name="arrow" size={18} />
      </a>
    </div>
    <p class="section-intro">
      仕事に役立つ知識も、暮らしに身近な知識も。
      <br />
      まずは気になる資格の、最初のレッスンへ。
    </p>
    <p class="notice compact">
      簿記を学びたい方へ：
      <a href={href('qualifications/boki/')}>簿記初級・原価計算初級・3級・2級・1級の違いと学習順を見る</a>
    </p>
    <div class="qualification-grid">
      {qualifications.map((q) => (
        <QualificationCard q={q} />
      ))}
    </div>
    <p class="sample-caption">公開中：{availabilityText}。各コースの適用範囲と公式資料もご確認ください。</p>
  </section>
  <section class="learning-section">
    <div class="container learning-grid">
      <div>
        <p class="eyebrow">忙しい毎日にも、学べる余白を</p>
        <h2>
          少しずつだから、
          <br />
          続けられる。
        </h2>
        <p>
          通勤の合間に。ひと息ついた夜に。
          <br />
          一度に全部覚えなくても、大丈夫。
          <br />
          自分に合ったペースを見つけてください。
        </p>
        <a class="text-link" href={href('guide/')}>
          資格ステップノートの使い方 <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="feature-list">
        <article>
          <span class="feature-icon">
            <Icon name="book" />
          </span>
          <div>
            <h3>迷わない、学習ステップ</h3>
            <p>基礎から順番に。次に何を学ぶかがわかるから、初めてでも取り組みやすい。</p>
          </div>
        </article>
        <article>
          <span class="feature-icon">
            <Icon name="star" />
          </span>
          <div>
            <h3>気になるところは、あとで復習</h3>
            <p>星をつけたレッスンをまとめて確認。理解できたところは「学習済み」に。</p>
          </div>
        </article>
        <article>
          <span class="feature-icon">
            <Icon name="shield" />
          </span>
          <div>
            <h3>登録なしで、学びを記録</h3>
            <p>進み具合はこの端末に保存。バックアップを書き出して、大切な記録を手元に残せます。</p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section container faq-home">
    <div>
      <p class="eyebrow">始める前に</p>
      <h2>よくある質問</h2>
      <a class="text-link" href={href('faq/')}>
        よくある質問をすべて見る
      </a>
    </div>
    <div>
      <details>
        <summary>本当に無料で使えますか？</summary>
        <p>
          公開している教材と学習機能は、すべて無料です。会員登録や有料プランへの加入も必要ありません。資格試験の受験料は別途、主催者に確認してください。
        </p>
      </details>
      <details>
        <summary>学習記録はどこに保存されますか？</summary>
        <p>
          今お使いのブラウザに保存します。ほかの端末には自動で同期されません。ブラウザのデータを削除すると記録が失われる場合があるため、マイ学習からバックアップを書き出してください。
        </p>
      </details>
      <details>
        <summary>このサイトだけで試験範囲を学べますか？</summary>
        <p>
          コースごとに範囲が異なります。{availabilityText}
          を公開しています。ITパスポートは現行シラバスの63項目に対応する基礎教材です。全用語例の解説や合格を保証するものではありません。公式資料とあわせて学習してください。
        </p>
      </details>
    </div>
  </section>
</Layout>
