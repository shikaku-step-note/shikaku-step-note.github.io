---
import Layout from '../../layouts/Layout.astro';
import { href } from '../../lib/site';
import QualificationCard from '../../components/QualificationCard.astro';
import { qualifications, availabilityText } from '../../data/qualifications';
---

<Layout
  title="資格一覧・学習コース"
  description="ITパスポート・宅建士・日商簿記初級・原価計算初級・3級・2級・1級、FP3級の教材を公開。分野と公開範囲を比べて、無料・登録不要で学び始められます。"
  breadcrumbs={[{ name: '資格一覧', path: 'qualifications/' }]}
>
  <section class="container page-section">
    <div class="page-heading">
      <p class="eyebrow">自分の「学びたい」を見つける</p>
      <h1>資格一覧</h1>
      <p>
        初めての分野も、ひとつずつ。
        <br />
        資格の特徴と学習ステップを見比べて、最初の一歩を選びましょう。
      </p>
    </div>
    <p class="notice compact">
      <a href={href('qualifications/boki/')}>日商簿記の級・区分の違いと選び方</a>
      。ユニットはサイト独自の学習段階で、公式の級とは異なります。
    </p>
    <div class="filter-row" role="group" aria-label="分野で絞り込む">
      <button class="filter active" type="button" data-filter="all" aria-pressed="true">
        すべて
      </button>
      {[...new Set(qualifications.map((q) => q.category))].map((category) => (
        <button class="filter" type="button" data-filter={category} aria-pressed="false">
          {category}
        </button>
      ))}
    </div>
    <p class="sr-only" data-filter-count role="status">
      {qualifications.length}件の資格
    </p>
    <div class="qualification-grid">
      {qualifications.map((q) => (
        <div data-category={q.category}>
          <QualificationCard q={q} />
        </div>
      ))}
    </div>
    <aside class="notice">
      <strong>公開内容について</strong>
      <p>
        {availabilityText}
        を公開しています。受験日・費用・最新の出題範囲などは、各コースに掲載した公式サイトでご確認ください。学習時間の表示は当サイトの目安です。
      </p>
    </aside>
  </section>
</Layout>
