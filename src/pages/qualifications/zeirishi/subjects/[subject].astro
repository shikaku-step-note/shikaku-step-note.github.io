---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Icon from '../../../../components/Icon.astro';
import Share from '../../../../components/Share.astro';
import TaxExpandedUnits from '../../../../components/TaxExpandedUnits.astro';
import { zeirishiDeepLessons } from '../../../../data/zeirishi-expanded';
import {
  zeirishiSubjects,
  zeirishiOutline,
  zeirishiSources,
  zeirishiReviewed,
} from '../../../../data/zeirishi';
import { href } from '../../../../lib/site';
export function getStaticPaths() {
  return zeirishiSubjects.map((subject) => ({ params: { subject: subject.id }, props: { subject } }));
}
const { subject: s } = Astro.props;
const rows = zeirishiOutline.filter((r) => r.subject === s.id);
const lessons = (
  await getCollection(
    'lessons',
    (l) => l.data.qualification === 'zeirishi' && l.data.subject === s.id && !l.data.archived && !l.data.stableId.startsWith('zr2-'),
  )
).sort((a, b) => a.data.order - b.data.order);
const deepLessons = zeirishiDeepLessons.filter((lesson) => lesson.subject === s.id);
const description = deepLessons.length
  ? `税理士試験「${s.name}」の無料教材。詳しく学ぶ${deepLessons.length}講と入門${lessons.length}講から学習順を選べます。解説・例題・計算や記述の演習、用語テストを用意し、全体の未完了範囲も示します。`
  : `税理士試験「${s.name}」の無料入門教材。${lessons.length}講の解説・例題・用語と復習問題を学べます。本試験に向けて拡充が必要な範囲と、追加学習の計画も示します。`;
---

<Layout
  title={`税理士・${s.name}の無料教材と学習順`}
  description={description}
  schema={{
    '@type': 'LearningResource',
    name: `税理士・${s.name}の学習案内`,
    inLanguage: 'ja',
    isAccessibleForFree: true,
    learningResourceType: '科目別学習案内',
    teaches: [...rows.flatMap((r) => r.objectives), ...deepLessons.flatMap((lesson) => lesson.objectives)],
    dateModified: [zeirishiReviewed, ...deepLessons.map((lesson) => lesson.reviewed)].sort().at(-1),
  }}
  breadcrumbs={[
    { name: '資格一覧', path: 'qualifications/' },
    { name: '税理士', path: 'qualifications/zeirishi/' },
    { name: s.name, path: `qualifications/zeirishi/subjects/${s.id}/` },
  ]}
>
  <div class="container page-section">
    <header class="page-heading">
      <p class="eyebrow">
        税理士試験・{s.category}／{s.category === '会計学' ? '必須科目' : '選択科目'}
      </p>
      <h1>{s.name}を学ぶ</h1>
      <p class="lead">{s.scope}</p>
      <p>{description}</p>
      <div class="button-row">
        <a
          class="button primary"
          data-course-start="zeirishi"
          data-course-subject={s.id}
          href={href(`qualifications/zeirishi/${rows[0]!.id}/`)}
        >
          この科目の学習を始める <Icon name="arrow" size={18} />
        </a>
        <a href={href(`downloads/zeirishi-${s.id}-curriculum.txt`)} download>
          科目の学習ツリー・学習案（TXT）
        </a>
      </div>
    </header>
    <div class="course-grid">
      <div>
        <section class="course-section">
          <h2>前提と、学ぶ順序</h2>
          <p>{s.prerequisite}</p>
          <p>
            最初に基本の関係を捉え、例題と条件を変えた比較で手順を確認し、最後に手続・総復習へ進みます。各レッスンの時間は、本文を読むだけでなく、手で例題を解き、理解度チェックと解説を確認する独自の目安です。難しい箇所は複数日に分けてください。
          </p>
          <p>
            入門課程では主要な仕組みを学び、詳しい学習ユニットでは、条件の判断や計算・記述を練習します。科目全体の教材は拡充中です。公開済みの教材と、まだ学習できない範囲は、<a href={href('qualifications/zeirishi/coverage/')}>対応表と拡充計画</a>で確認できます。
          </p>
          {s.category === '税法' && (
            <p>
              税法科目の受験資格は公式案内で確認してください。学習段階は当サイトの独自区分で、公式の級ではありません。税法を3科目選ぶ際の組合せは、
              <a href={href('qualifications/zeirishi/#selection')}>科目選択の案内</a>で確認できます。
            </p>
          )}
        </section>
        <TaxExpandedUnits subject={s.id} />
        <section class="course-section" aria-labelledby="subject-steps">
          <h2 id="subject-steps">入門課程：{lessons.length}レッスンの学習ツリー</h2>
          <p data-course-progress="zeirishi" data-course-subject={s.id} data-course-unit={s.unit}>
            このブラウザの記録を読み込んでいます
          </p>
          <progress
            data-course-bar="zeirishi"
            data-course-subject={s.id}
            data-course-unit={s.unit}
            max={lessons.length}
            value="0"
            aria-label={`${s.name}の学習済みレッスン数`}
          >
            0 / {lessons.length}
          </progress>
          {[...new Set(rows.map((r) => r.stage))].map((stage) => (
            <section class="curriculum-unit">
              <h3>{stage}</h3>
              <ol class="lesson-list">
                {lessons
                  .filter((l) => rows.find((r) => r.id === l.data.stableId)?.stage === stage)
                  .map((l) => (
                    <li class="lesson-row" data-lesson-row={l.data.stableId}>
                      <span class="lesson-number">
                        {rows.find((r) => r.id === l.data.stableId)?.position}
                      </span>
                      <div class="lesson-row-body">
                        <h4>
                          <a href={href(`qualifications/zeirishi/${l.data.stableId}/`)}>{l.data.title}</a>
                        </h4>
                        <p>{l.data.objectives.join('／')}</p>
                        <div class="lesson-meta">
                          <span>{l.data.minutes}分の目安</span>
                          <span data-status-label={l.data.stableId}>未学習</span>
                        </div>
                      </div>
                      <button disabled aria-busy="true"
                        class="star-button"
                        type="button"
                        data-bookmark={l.data.stableId}
                        aria-pressed="false"
                        aria-label={`${l.data.title}をブックマーク`}
                      >
                        <Icon name="star" size={21} />
                      </button>
                    </li>
                  ))}
              </ol>
            </section>
          ))}
        </section>
        <section class="course-section">
          <h2>用語・科目総復習・模試で振り返る</h2>
          <div class="assessment-links">
            <a
              class="assessment-link"
              href={href(`qualifications/zeirishi/tests/zeirishi-unit-${s.unit}-glossary/`)}
            >
              <strong>累積用語確認</strong>
              <span>本文の定義から生成・学び直す用語を確認</span>
            </a>
            <a
              class="assessment-link"
              href={href(`qualifications/zeirishi/tests/zeirishi-unit-${s.unit}-review/`)}
            >
              <strong>科目総復習</strong>
              <span>各レッスンの問題を再利用する復習</span>
            </a>
            <a class="assessment-link" href={href(`qualifications/zeirishi/tests/zeirishi-${s.id}-mock/`)}>
              <strong>120分の独自基礎模試</strong>
              <span>時間あり／時間制限なし・独立した数値と記述の演習</span>
            </a>
          </div>
          <p>
            2026年8月本試験の大問配点は{s.majorPoints.join('・')}
            点、時間は120分です。独自模試では大問配点と時間を参照しますが、小問数・資料量・難易度・詳細配点は公式と同一ではありません。記述は解答例と独自の基準で自己確認し、公式の60％基準へ換算した合否は判定しません。
          </p>
          <p>
            学習済みの印はページを読んだ記録です。用語の正答、計算の正答、記述の自己確認とは分けて保存します。結果の「要復習」から本文へ戻り、翌日と1週間後に理由を説明し直してください。
          </p>
        </section>
        <section class="course-section">
          <h2>この基礎課程の後に補うこと</h2>
          <ul>
            {rows.map((r) => (
              <li>
                <strong>{r.title}</strong>：{r.additionalStudy}
              </li>
            ))}
          </ul>
          <p>
            一科目につき8週間を目安に基礎・復習・模試を巡る
            <a href={href('qualifications/zeirishi/#schedule')}>独自の学習案</a>
            を用意しています。公式の公表問題で資料の読み方と記述形式を確認し、不足する個別論点と総合問題を追加してください。
          </p>
          <a href={href('qualifications/zeirishi/coverage/')}>技能ごとの対応表と制約を見る</a>
        </section>
        <section class="course-section">
          <h2>公式の範囲と、主な参照資料</h2>
          <p>
            法令は第76回公告の2026年4月3日現在施行を基準とし、例題の年分・事業年度・仮定を明示しています。後の施行改正を現在の実務へ適用する際は、最新の公式案内で改めて確認してください。個別の税務助言を目的とした教材ではありません。
          </p>
          <ul>
            {zeirishiSources
              .filter((source) => [s.pointSource, ...s.sourceIds].includes(source.id))
              .map((source) => (
                <li>
                  <a href={source.url}>{source.title}</a>：{source.version}（確認日：{source.verified}）
                </li>
              ))}
          </ul>
        </section>
        <Share title={`税理士・${s.name}の無料基礎学習`} url={new URL(Astro.url.pathname, Astro.site).href} />
      </div>
      <aside class="course-sidebar">
        <div class="sidebar-box">
          <h2>この科目の記録</h2>
          <p>
            記録はこの端末のブラウザに保存されます。自動同期はなく、ブラウザデータを消すと失われる場合があります。
          </p>
          <a href={href('progress/#backup')}>マイ学習・バックアップ</a>
          <p>教材確認：{zeirishiReviewed}</p>
        </div>
        <div class="sidebar-box">
          <h2>科目を切り替える</h2>
          <ul>
            {zeirishiSubjects.map((subject) => (
              <li>
                <a
                  href={href(`qualifications/zeirishi/subjects/${subject.id}/`)}
                  aria-current={subject.id === s.id ? 'page' : undefined}
                >
                  {subject.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
<style>
  progress {
    width: 100%;
  }
  .lesson-row h4 {
    margin: 0;
    font-size: 1.05rem;
  }
  .lesson-row p {
    font-size: 0.9rem;
    margin: 0 0 0.4rem;
  }
  .curriculum-unit {
    padding: 1rem;
    margin: 1rem 0;
  }
</style>
