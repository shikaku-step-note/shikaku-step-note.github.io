---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import Share from '../../../components/Share.astro';
import Assessment from '../../../components/Assessment.astro';
import { ipSource, units } from '../../../data/it-passport';
import { allAssessments } from '../../../data/assessments';
import { bokiCourse } from '../../../data/bookkeeping';
import { takkenOutline, takkenSources } from '../../../data/takken';
import { zeirishiOutline, zeirishiSources, zeirishiSubject } from '../../../data/zeirishi';
import { zeirishiDeepLesson, zeirishiDeepUnit } from '../../../data/zeirishi-expanded';
import { qualificationById } from '../../../data/qualifications';
import { href } from '../../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('lessons')).map((lesson) => ({
    params: { qualification: lesson.data.qualification, lesson: lesson.data.stableId },
    props: { lesson },
  }));
}
const { lesson } = Astro.props;
const d = lesson.data;
const q = qualificationById(d.qualification);
const allLessons = await getCollection('lessons');
const tax = q.id === 'zeirishi';
const subject = tax ? zeirishiSubject(d.subject!) : undefined;
const deepLesson = tax ? zeirishiDeepLesson(d.stableId) : undefined;
const deepUnit = deepLesson ? zeirishiDeepUnit(deepLesson.moduleId) : undefined;
const coursePath = deepUnit
  ? `qualifications/zeirishi/units/${deepUnit.id}/`
  : subject ? `qualifications/zeirishi/subjects/${subject.id}/` : `qualifications/${q.id}/`;
const siblings = allLessons
  .filter(
    (l) =>
      l.data.qualification === q.id &&
      (d.archived ? l.data.archived : !l.data.archived) &&
      (!tax || l.data.subject === d.subject) &&
      (!tax || (deepUnit ? l.data.unit === deepUnit.number : !l.data.stableId.startsWith('zr2-'))),
  )
  .sort((a, b) => a.data.order - b.data.order);
const index = siblings.findIndex((l) => l.data.stableId === d.stableId);
const prev = siblings[index - 1];
const next = siblings[index + 1];
const { Content, headings } = await render(lesson);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const assessment = d.unit
  ? allAssessments(allLessons).find((a) => a.id === `${d.stableId}-check`)
  : undefined;
const boki = bokiCourse(q.id);
const takken = q.id === 'takken';
const testPrefix = q.id === 'it-passport' ? 'ip' : q.id;
const courseSources = takken
  ? takkenSources.filter((s) => takkenOutline.find((r) => r.id === d.stableId)?.sources.includes(s.id))
  : tax
    ? zeirishiSources.filter((s) => zeirishiOutline.find((r) => r.id === d.stableId)?.sources.includes(s.id))
    : [];
const unit = units.find((u) => u.id === d.unit);
const glossaryId = deepUnit?.assessments.find((a) => a.kind === 'glossary')?.id ?? `${testPrefix}-unit-${d.unit}-glossary`;
const reviewId = deepUnit?.assessments.find((a) => a.kind === 'review')?.id ?? `${testPrefix}-unit-${d.unit}-review`;
---

<Layout
  title={`${d.title}｜${q.name}`}
  description={d.description}
  noindex={d.sample}
  schema={
    !d.sample
      ? {
          '@type': 'LearningResource',
          name: d.title,
          description: d.description,
          inLanguage: 'ja',
          isAccessibleForFree: true,
          learningResourceType: 'レッスン',
          teaches: d.objectives,
          dateModified: d.updated,
          url: canonical,
        }
      : undefined
  }
  breadcrumbs={[
    { name: '資格一覧', path: 'qualifications/' },
    { name: q.name, path: `qualifications/${q.id}/` },
    ...(subject ? [{ name: subject.name, path: `qualifications/zeirishi/subjects/${subject.id}/` }] : []),
    ...(deepUnit ? [{ name: deepUnit.title, path: coursePath }] : []),
    { name: d.title, path: `qualifications/${q.id}/${d.stableId}/` },
  ]}
>
  <div class="container lesson-layout page-section">
    <article data-current-lesson={d.stableId}>
      <header class="lesson-header">
        <div class="lesson-kicker">
          <a class="tag" href={href(`qualifications/${q.id}/`)}>
            {q.name}
          </a>
          <span>
            {subject ? `${subject.name}・` : ''}STEP {index + 1} / {siblings.length}
          </span>
          <span>
            <Icon name="clock" size={15} />
            {d.minutes}分
          </span>
        </div>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="sample-caption">
          {d.archived
            ? '旧サンプル教材（記録を保管）'
            : d.sample
              ? '入門サンプル教材・独自の解説と練習問題'
              : (d.scopeLabel ?? `シラバスVer.6.5・ユニット${d.unit} ${unit?.name}・独自教材`)}
        </p>
        <div class="lesson-toolbar">
          <button class="button secondary" data-start={d.stableId} type="button">
            学習を始める
          </button>
          <button class="bookmark-text" data-bookmark={d.stableId} aria-pressed="false" type="button">
            <Icon name="star" size={19} />
            <span>あとで復習</span>
          </button>
          <span class="status-pill" data-status-label={d.stableId}>
            未学習
          </span>
        </div>
      </header>
      {d.sample && (
        <div class="notice compact">
          <p>
            この教材は学習機能を体験するためのサンプルです。試験範囲を網羅していません。
            {q.id === 'fp-3' ? '個別の投資・税務・保険の助言を目的としません。' : ''}
          </p>
          {d.archived && (
            <p>
              現行コースは新しいレッスンとして公開しました。この記録は新コースの完了数へ加算されません。
              <a href={href(`qualifications/${q.id}/`)}>現行コースへ</a>
            </p>
          )}
        </div>
      )}
      {d.objectives.length > 0 && (
        <section class="lesson-objectives">
          <h2>このレッスンの目標</h2>
          <ul>
            {d.objectives.map((o) => (
              <li>{o}</li>
            ))}
          </ul>
          <p class="muted">前提：{d.prerequisite}</p>
          <p class="muted">
            {tax
              ? `${subject?.name}の学習目標（公式の項目番号ではありません）`
              : takken
                ? '公式の出題範囲の号番号（学習ユニットとは別）'
                : boki
                  ? '教材内の対応番号（公式の番号ではありません）'
                  : '公式シラバス対応項目'}
            {d.syllabus.length ? `：${d.syllabus.join('、')}` : ''}
            。表示時間は、読む・例題・問題と解説の確認を含む当サイトの学習目安です。
          </p>
        </section>
      )}
      {deepLesson && (
        <section class="notice compact" aria-label="このレッスンの前提">
          <h2>先に確認するレッスン</h2>
          <ul>{deepLesson.prerequisites.map((id) => {
            const prerequisite = allLessons.find((entry) => entry.data.stableId === id);
            return prerequisite && <li><a href={href(`qualifications/zeirishi/${id}/`)}>{prerequisite.data.title}</a></li>;
          })}</ul>
          <p>以前の入門ページの学習済み記録と、このレッスンの記録は別に保管します。本文の理解と、理解度チェックの結果も区別して確認してください。</p>
        </section>
      )}
      <nav class="toc mobile-toc" aria-label="このレッスンの目次">
        <h2>このレッスンの目次</h2>
        <ol>
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          <li>
            <a href="#practice">理解をたしかめる</a>
          </li>
        </ol>
      </nav>
      <div class="prose lesson-content">
        <Content />
      </div>
      {d.glossary.length > 0 && (
        <section class="prose lesson-glossary">
          <h2>このレッスンの用語</h2>
          <dl>
            {d.glossary.map((g) => (
              <>
                <dt>
                  <strong>{g.term}</strong>
                </dt>
                <dd>{g.definition}</dd>
              </>
            ))}
          </dl>
          <p>
            <a href={href(`qualifications/${q.id}/tests/${glossaryId}/`)}>
              {tax && !deepUnit ? 'この科目の用語テストへ' : 'このユニットの用語テストへ'}
            </a>
            ・
            <a href={href(`qualifications/${q.id}/tests/${reviewId}/`)}>
              {tax && !deepUnit ? '科目総復習へ' : 'ユニット総合確認へ'}
            </a>
          </p>
        </section>
      )}
      {assessment ? (
        <div id="practice">
          <Assessment assessment={assessment} />
        </div>
      ) : (
        <section class="quiz" id="practice" data-quiz={d.stableId} data-answer={d.answer}>
          <p class="eyebrow">理解をたしかめる</p>
          <h2>練習問題</h2>
          <form>
            <fieldset>
              <legend>{d.question}</legend>
              {d.options!.map((o, i) => (
                <label class="quiz-option">
                  <input type="radio" name="answer" value={i} required />
                  <span>{o}</span>
                </label>
              ))}
            </fieldset>
            <button class="button primary" type="submit">
              答えを確認する
            </button>
            <div class="quiz-feedback" role="status" tabindex="-1" hidden>
              <strong data-quiz-result></strong>
              <p>{d.explanation}</p>
              <p class="muted">何度でも解き直せます。学習済みへの変更は、下のボタンで行えます。</p>
            </div>
          </form>
        </section>
      )}
      <section class="lesson-complete">
        <div>
          <h2>ここまで、おつかれさまでした。</h2>
          <p>理解できたら記録して、次の一歩へ。</p>
        </div>
        <button class="button primary" data-complete={d.stableId} type="button">
          <Icon name="check" size={19} />
          学習済みにする
        </button>
      </section>
      <p class="muted saved-note">
        学習記録はこの端末のブラウザに保存されます。<a href={href('guide/')}>保存とバックアップについて</a>
      </p>
      <nav class="lesson-pagination" aria-label="前後のレッスン">
        {prev ? (
          <a href={href(`qualifications/${q.id}/${prev.data.stableId}/`)}>
            <small>前のレッスン</small>
            {prev.data.title}
          </a>
        ) : (
          <a href={href(coursePath)}>
            <small>コースに戻る</small>
            {subject?.name ?? q.name}の学習ステップ
          </a>
        )}
        {next ? (
          <a href={href(`qualifications/${q.id}/${next.data.stableId}/`)}>
            <small>次のレッスン</small>
            {next.data.title}
          </a>
        ) : (
          <a
            href={
              tax ? href(`qualifications/zeirishi/tests/${reviewId}/`) : href('progress/')
            }
          >
            <small>学びを振り返る</small>
            {deepUnit ? 'このユニットの総合確認へ' : tax ? 'この科目の総復習へ' : 'マイ学習を見る'}
          </a>
        )}
      </nav>
      <section class="source-note">
        <h2>出典・教材について</h2>
        <p>
          文章・例題・図表は当サイトが作成した{d.sample ? '入門用サンプル' : '独自教材'}
          です。公式問題の転載ではありません。資格概要の参照先：
          <a href={q.official} target="_blank" rel="noopener noreferrer">
            {q.officialName}（新しいタブ）
          </a>
          。
        </p>
        <p>
          教材更新日：<time datetime={d.updated}>{d.updated}</time>。<a href={href('editorial/')}>編集方針</a>
          ・<a href={href('contact/')}>訂正の連絡方法</a>
        </p>
        {boki && (
          <p>
            範囲・公式資料の確認日：2026年10月25日。
            <a href={href(`qualifications/${q.id}/coverage/`)}>対応表と出典一覧</a>
            をご確認ください。金額は独自の学習例です。
          </p>
        )}
        {(takken || tax) && (
          <div>
            <p>
              {tax
                ? '第76回の法令基準日：2026年4月3日。対象年分・事業年度・例の仮定を確認してください。個別の税務・会計の助言ではありません。'
                : '法令基準日：2026年4月1日。資料確認日：2026年10月25日。個別取引・税務・建築の助言ではありません。'}
            </p>
            <ul>
              {(deepLesson?.references ?? courseSources).map((s) => (
                <li>
                  <a href={s.url}>{s.title}</a>：{'locator' in s ? `${s.locator}。` : ''}{s.version}（確認日：{s.verified}）
                </li>
              ))}
            </ul>
            <a href={href(`qualifications/${q.id}/coverage/`)}>全分野の対応表・公式資料・追加学習の範囲</a>
          </div>
        )}
        {d.unit && q.id === 'it-passport' && (
          <p>
            範囲確認：<a href={ipSource('syllabus').url}>IPA シラバスVer.6.5</a>（確認日{' '}
            {ipSource('syllabus').verified}
            ）。全用語例の暗記や出題の予測を保証する教材ではありません。
            <a href={href('qualifications/it-passport/coverage/')}>対応表と出典一覧</a>
            で範囲と制約を確認できます。
          </p>
        )}
      </section>
      <Share title={`${d.title}｜${q.name}`} url={canonical} />
    </article>
    <aside class="lesson-sidebar">
      <nav class="toc" aria-label="レッスンの目次">
        <h2>このレッスンの目次</h2>
        <ol>
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          <li>
            <a href="#practice">理解をたしかめる</a>
          </li>
        </ol>
      </nav>
      <div class="sidebar-box">
        <h2>{deepUnit?.title ?? subject?.name ?? q.name}</h2>
        <p data-course-progress={q.id} data-course-subject={subject?.id} data-course-unit={deepUnit?.number}>
          未学習
        </p>
        <a href={href(coursePath)}>学習ステップに戻る</a>
      </div>
    </aside>
  </div>
</Layout>
