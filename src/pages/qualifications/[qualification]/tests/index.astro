---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import { bokiCourses } from '../../../../data/bookkeeping';
import { allAssessments } from '../../../../data/assessments';
import { href } from '../../../../lib/site';
import { beginnerUnitReviewCount } from '../../../../data/boki-beginner';
export function getStaticPaths() {
  return [...bokiCourses, { id: 'takken', name: '宅建士' }, { id: 'zeirishi', name: '税理士' }].map(
    (course) => ({
      params: { qualification: course.id },
      props: { course },
    }),
  );
}
const { course } = Astro.props;
const tests = allAssessments(await getCollection('lessons')).filter(
  (a) => a.qualification === course.id && a.kind !== 'lesson',
);
---

<Layout
  title={`${course.name}の用語・総復習・模擬試験`}
  description={`${course.name}の用語確認、ユニット総合確認、総復習、独自模試を選べます。解答と結果はブラウザに保存します。`}
  breadcrumbs={[
    { name: '資格一覧', path: 'qualifications/' },
    { name: course.name, path: `qualifications/${course.id}/` },
    { name: 'テスト一覧', path: `qualifications/${course.id}/tests/` },
  ]}
>
  <article class="container prose wide-prose page-section">
    <h1>{course.name}のテストを選ぶ</h1>
    <p>
      用語の確認から応用へ進み、最後に時間を計って演習します。レッスンの学習済み状態と、テストの得点は別の記録です。
    </p>
    <p>{course.id === 'zeirishi'
      ? '科目全体の用語問題は本文の定義から生成し、科目総復習はレッスン問題を再利用します。単元別の用語と総合確認は、それぞれ別に作成した問題です。各テストの説明で確認できます。'
      : course.id === 'boki-beginner'
        ? `用語問題は本文の定義から作成し、用語総復習はその問題を再利用します。ユニット確認${beginnerUnitReviewCount}問はレッスン末尾とは別の問題です。総復習24問は新しい複合問題12問と再利用12問。模試第1回・第2回はそれぞれ独立した30小問で、共通の月次資料も異なります。旧版の短縮練習は全量模試と区別して残しています。`
        : '用語問題は本文の定義から生成します。ユニット確認と総復習はレッスンの問題を再利用し、模試には別の独自問題を使います。'}何度でも解き直せますが、同じ問題の点数が上がっただけで範囲全体を習得したとは判断しません。</p>
    {course.id === 'takken' && (
      <div class="notice compact">
        <p>
          一般形式は50問・120分、5問免除形式は45問・110分です。後者は一般形式の45問を共有し、別セットではありません。各問1点の練習得点を表示し、当年度の合否は判定しません。公式の免除を得るための講習ではありません。
        </p>
        <a href={href('qualifications/takken/coverage/')}>適用法令と追加学習が必要な範囲</a>
      </div>
    )}
    {course.id === 'zeirishi' && (
      <div class="notice compact">
        <p>
          11科目のテストを用意しています。通常は会計学2科目と税法3科目を選ぶ制度で、全てを受験する必要はありません。各模試は120分の独自基礎演習です。大問配点を参照しますが、資料量・難易度・小問数は公式と異なります。記述は独自基準で自己確認し、公式の合否は判定しません。
        </p>
        <a href={href('qualifications/zeirishi/#subjects')}>科目別の教材と学習順へ</a>
      </div>
    )}
    <ul class="test-directory">
      {tests.map((a) => (
        <li>
          <h2>
            <a href={href(`qualifications/${a.qualification}/tests/${a.id}/`)}>{a.title}</a>
          </h2>
          <p>
            {a.questions.length}小問{a.minutes ? `・時間あり${a.minutes}分／時間制限なし` : '・時間制限なし'}
          </p>
        </li>
      ))}
    </ul>
    <p>
      端末の時計変更による影響は防げません。時間ありの演習では閉じている間も時間が進みます。
      <a href={href('guide/')}>記録と使い方</a> ・{' '}
      <a href={href(`qualifications/${course.id}/coverage/`)}>公式資料と制約</a>
    </p>
  </article>
</Layout>
