{
  "name": "shikaku-step-note",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node --import tsx scripts/export-ip-curriculum.mjs && node --import tsx scripts/export-boki-curriculum.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node scripts/verify.mjs",
    "test:storage": "node --import tsx --test tests/storage.test.ts tests/assessment.test.ts tests/bookkeeping.test.ts",
    "curriculum": "node --import tsx scripts/export-ip-curriculum.mjs && node --import tsx scripts/export-boki-curriculum.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/cli": "0.1.22",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.0",
    "yaml": "2.9.1"
  }
}
