        "ac2-bank-boki74",
        "ac2-bank-zaimu71",
        "financial-regulations"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-13",
      "term": "営業上の受取手形",
      "definition": "通常の営業取引から受け取った手形債権。営業外の資産売却や貸付を示す金融手形と発生原因を区分する",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        1
