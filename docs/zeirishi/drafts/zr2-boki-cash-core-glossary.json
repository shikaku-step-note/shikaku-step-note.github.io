        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-14",
      "term": "営業外受取手形",
      "definition": "備品売却等の営業外取引から受け取った手形債権を、営業上の受取手形と分ける科目",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        1
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-15",
      "term": "金融手形",
      "definition": "商品取引等の決済ではなく資金貸借のために用いる手形。受領した形式だけで貸付金の性質が変わるとは限らない",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        1
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-16",
      "term": "手形割引",
      "definition": "満期前の手形を銀行等へ譲渡して資金化する取引。消滅要件と新たな保証債務、割引料を区分して計算する",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        2
