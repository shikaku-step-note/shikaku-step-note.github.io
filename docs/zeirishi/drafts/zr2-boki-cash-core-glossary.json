        2
      ],
      "sourceRefIds": [
        "ac2-bank-boki74",
        "ac2-bank-zaimu71",
        "financial-regulations"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-8",
      "term": "未渡小切手",
      "definition": "作成済みでも支払先へ未交付の小切手。先に支払記帳していればその記帳を戻す必要がある",
      "lessonId": "zr2-boki-bank-reconciliation",
      "objectives": [
        2
      ],
      "sourceRefIds": [
        "ac2-bank-boki74",
        "ac2-bank-zaimu71",
        "financial-regulations"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-9",
      "term": "未取立の入金",
      "definition": "会社が入金を正しく記帳した一方、銀行側でまだ取立て・加算が終わっていない照合差。差の具体的事実を確認する",
      "lessonId": "zr2-boki-bank-reconciliation",
      "objectives": [
        1
      ],
      "sourceRefIds": [
        "ac2-bank-boki74",
        "ac2-bank-zaimu71",
        "financial-regulations"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-10",
      "term": "未通知の銀行取引",
      "definition": "銀行が会社の実際の取引を記帳したが会社はまだ記帳していない差。銀行自体の誤処理とは区別する",
      "lessonId": "zr2-boki-bank-reconciliation",
      "objectives": [
        1,
        3
      ],
      "sourceRefIds": [
        "ac2-bank-boki74",
        "ac2-bank-zaimu71",
        "financial-regulations"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-11",
      "term": "銀行勘定調整表",
      "definition": "会社と銀行の残高差を原因別に調整し、修正後残高と会社の必要仕訳を確認する表",
      "lessonId": "zr2-boki-bank-reconciliation",
