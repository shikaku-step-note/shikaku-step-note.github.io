        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-17",
      "term": "手形裏書譲渡",
      "definition": "手形上の権利を裏書により他者へ移す取引。原債務の決済や新たな保証義務、消滅要件を区分する",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        2
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-18",
      "term": "不渡手形",
      "definition": "不渡りとなった手形について残存又は取得する請求権を整理する勘定。請求権の範囲と回収可能性は別に判断する",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        3
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-19",
      "term": "手形更改",
      "definition": "満期延長等に伴い旧手形を新手形へ入れ替える取引。同じ元本を新旧で二重計上せず、利息の条件を別に整理する",
      "lessonId": "zr2-boki-bills-receivable",
      "objectives": [
        4
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-bills-law",
        "ac2-accounting-principles"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-20",
      "term": "電子記録債権",
      "definition": "発生記録を効力要件とする金銭債権。発生・譲渡・支払等の記録の段階と現金決済を区分する",
