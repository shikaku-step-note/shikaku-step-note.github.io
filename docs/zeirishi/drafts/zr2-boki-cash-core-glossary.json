        1
      ],
      "sourceRefIds": [
        "ac2-bank-boki74",
        "ac2-bank-zaimu71",
        "financial-regulations"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-12",
      "term": "当座借越",
      "definition": "当座取引の借越契約等に基づく借入れ。照合では負の残高で追い、決算の帳簿振替と負債表示を区分する",
      "lessonId": "zr2-boki-bank-reconciliation",
