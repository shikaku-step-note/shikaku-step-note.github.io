      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-21",
      "term": "金融資産の消滅",
      "definition": "権利行使・権利喪失又は支配移転等の基準に従い、金融資産を帳簿から除く処理",
      "lessonId": "zr2-boki-receivable-transfers",
      "objectives": [
        2
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-22",
      "term": "支配移転",
      "definition": "金融資産の譲渡で、法的保全、譲受人の権利享受、実質的な買戻し権利義務等の要件を通じて判断する消滅の条件",
      "lessonId": "zr2-boki-receivable-transfers",
      "objectives": [
        2
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-23",
      "term": "譲渡に伴う保証債務",
      "definition": "金融資産の譲渡で新たに生じる保証義務を負債として認識したもの。主債務の額面と初期認識時価を区分する",
      "lessonId": "zr2-boki-receivable-transfers",
      "objectives": [
        3
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-24",
      "term": "譲渡金額",
      "definition": "金融資産の消滅損益を求める際、受取金額に新たな資産の時価を加え、新たな負債の時価を差し引いて求める金額。残存部分の原価配分は別に行う",
      "lessonId": "zr2-boki-receivable-transfers",
      "objectives": [
        3
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-25",
      "term": "残存部分の原価配分",
      "definition": "一部消滅時に譲渡部分と残る部分の相対的な時価で元の帳簿価額を分ける処理。残存部分の時価評価と区分する",
      "lessonId": "zr2-boki-receivable-transfers",
      "objectives": [
        4
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-26",
      "term": "留保した回収サービス権",
      "definition": "金融資産譲渡後に留保する回収業務に係る権利。通常収益超過等の条件による資産認識を検討し、残存部分として原価配分する",
      "lessonId": "zr2-boki-receivable-transfers",
      "objectives": [
        4
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide",
        "ac2-electronic-claims",
        "ac2-electronic-claims-law",
        "fsa-factoring-definition"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-27",
      "term": "一般債権",
      "definition": "経営状態に重大な問題が生じていない債務者への債権で、対象集団の実績率等により貸倒見積りを行う区分",
      "lessonId": "zr2-boki-credit-loss-measurement",
      "objectives": [
        1,
        2
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-28",
      "term": "貸倒懸念債権",
      "definition": "経営破綻には至らなくても財政状態等の悪化により、元利金を約定どおり回収できない可能性が高い債権の区分",
      "lessonId": "zr2-boki-credit-loss-measurement",
      "objectives": [
        1
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-29",
      "term": "破産更生債権等",
      "definition": "経営破綻又は実質的経営破綻に陥っている債務者への債権の区分。担保等の回収を除く部分の貸倒見積りを行う",
      "lessonId": "zr2-boki-credit-loss-measurement",
      "objectives": [
        1,
        2
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-30",
      "term": "貸倒見積高",
      "definition": "債権区分と回収見込みに応じて見積もった損失額。期末必要引当残高の計算と当期繰入額の算定を区分する",
      "lessonId": "zr2-boki-credit-loss-measurement",
      "objectives": [
        2,
        3
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-31",
      "term": "貸倒引当金繰入額",
      "definition": "必要引当残高へ合わせるため、取崩し等を反映した整理前残高との差額として当期に追加する額",
      "lessonId": "zr2-boki-credit-loss-measurement",
      "objectives": [
        4
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-32",
      "term": "貸倒実績率",
      "definition": "同一の開始債権集団から生じた貸倒額等を対応する債権額で除して求める率。算定期間・平均方法・現在リスクを確認する",
      "lessonId": "zr2-boki-credit-loss-measurement",
      "objectives": [
        5
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-33",
      "term": "貸倒DCF",
      "definition": "合理的に見積もった将来元利回収を、条件に応じた当初約定率又は取得当初実効率等で割り引き、帳簿との差から貸倒見積高を求める方法",
      "lessonId": "zr2-boki-bad-debt-dcf",
      "objectives": [
        1
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-34",
      "term": "時間経過の利息配分",
      "definition": "回収予測不変のもとで回収日までの期間短縮により純額が増える効果を収益へ配分する処理。現金受領とは別に追う",
      "lessonId": "zr2-boki-bad-debt-dcf",
      "objectives": [
        2
      ],
      "sourceRefIds": [
        "asbj-finance",
        "ac2-finance-guide"
      ]
    },
    {
      "id": "zr2-boki-cash-core-term-35",
      "term": "DCFの見積変更損益",
      "definition": "旧見積りで時間経過・回収を反映した純額と、新しい回収額・時期を割り引いた純額との差。期首期末引当差だけと区分する",
      "lessonId": "zr2-boki-bad-debt-dcf",
      "objectives": [
        3
      ],
